{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformManageExpensesTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": "arn:aws:dynamodb:eu-central-1:<ACCOUNT_ID>:table/personal-spends-expenses"
    },
    {
      "Sid": "TerraformManageUploadsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:Get*",
        "s3:PutBucketTagging",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::personal-spends-uploads-*"
    }
  ]
}
